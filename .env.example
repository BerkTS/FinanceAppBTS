PORT=8787

# Put this file at the repo root (same folder as the root package.json) as `.env`.
# The API loads that file explicitly — npm workspaces run the server with cwd=server/,
# so a plain dotenv default would miss the root `.env` without this project’s server bootstrap.

# --- NewsAPI (general + optional outlet domains) ---
# https://newsapi.org
NEWS_API_KEY=
NEWS_QUERY=stocks economy geopolitical
# Comma-separated domains (uses same NEWS_API_KEY). Availability depends on your NewsAPI plan.
# Example: cnbc.com  apnews.com  (reuters.com / bloomberg.com are often restricted on free tiers)
NEWSAPI_OUTLET_DOMAINS=
NEWSAPI_OUTLET_PAGE_SIZE=25
# NEWSAPI_FINANCE_QUERY=(stocks OR earnings OR fed)
# NEWSAPI_GEO_QUERY=(sanctions OR NATO OR diplomacy)

# --- Yahoo Finance (RSS, no API key) ---
# Comma-separated tickers for headline RSS; set DISABLE_YAHOO_RSS=1 to turn off.
YAHOO_FINANCE_RSS_TICKERS=AAPL,MSFT,GOOGL,^GSPC
# YAHOO_RSS_MAX_PER_FEED=12
# DISABLE_YAHOO_RSS=0

# --- RapidAPI (subscribe per API; one shared key) ---
# https://rapidapi.com — subscribe to CNBC / Reuters / “Bloomberg” style APIs you choose, then paste
# the full request URL from the RapidAPI “Code snippets” (Node fetch) into these vars.
RAPIDAPI_KEY=
# Real-Time Finance Data (Stock News + Currency News) — uses same RAPIDAPI_KEY after you subscribe:
# https://rapidapi.com → search “Real-Time Finance Data” → subscribe → enable Stock News & Currency News.
REALTIME_FINANCE_HOST=real-time-finance-data.p.rapidapi.com
REALTIME_FINANCE_STOCK_PATH=/stock-news
REALTIME_FINANCE_CURRENCY_PATH=/currency-news
REALTIME_STOCK_SYMBOLS=SPY,AAPL
# Majors as six letters (EURUSD) or explicit EUR:USD — API uses from_symbol + to_symbol.
REALTIME_CURRENCY_PAIRS=EURUSD
# REALTIME_FINANCE_REQUEST_GAP_MS=750
# REALTIME_FINANCE_NEWS=0   # set to 0 to disable this feed only

# YH Finance (RapidAPI) — dashboard “Yahoo Finance” (market news).
# Same RAPIDAPI_KEY as other RapidAPI products, **or** a dedicated key:
# YH_FINANCE_RAPIDAPI_KEY=
# Most reliable: paste the full URL from RapidAPI “Code snippets” (Node):
# YH_FINANCE_REQUEST_URL=https://yahoo-finance15.p.rapidapi.com/v1/markets/news?ticker=AAPL%2CTSLA
# Or set path + tickers (defaults try /v1/markets/news with ticker= first):
# YH_FINANCE_HOST=yahoo-finance15.p.rapidapi.com
# YH_FINANCE_MARKET_NEWS_PATH=/v1/markets/news
# YH_FINANCE_NEWS_TICKERS=AAPL,TSLA
# YH_FINANCE_NEWS_LIMIT=24
# YH_FINANCE_DISABLED=1

# Seeking Alpha (RapidAPI) — same RAPIDAPI_KEY; subscribe to “Seeking Alpha” on RapidAPI.
# Dashboard uses GET /symbols/get-ratings (consensus / quant / sell-side).
# SEEKING_ALPHA_HOST=seeking-alpha.p.rapidapi.com
# SEEKING_ALPHA_SYMBOLS=AAPL,MSFT,SPY
# SEEKING_ALPHA_RATINGS_PATH=/symbols/get-ratings
# SEEKING_ALPHA_REQUEST_GAP_MS=800
# SEEKING_ALPHA_DISABLED=1

# Real-Time News Data API (RapidAPI) — dashboard section + GET /top-headlines by default.
# Same RAPIDAPI_KEY. https://rapidapi.com → “Real-Time News Data” → subscribe.
# REALTIME_NEWS_DATA_HOST=real-time-news-data.p.rapidapi.com
# REALTIME_NEWS_DATA_PATH=/top-headlines
# REALTIME_NEWS_DATA_COUNTRY=US
# REALTIME_NEWS_DATA_LANG=en
# REALTIME_NEWS_DATA_CATEGORY=business
# REALTIME_NEWS_DATA_LIMIT=15
# REALTIME_NEWS_DATA_DISABLED=1

# CNBC Markets and News Data (RapidAPI) — dashboard “CNBC” section; GET /news/{category}.
# Same RAPIDAPI_KEY. Subscribe to “CNBC Markets and News Data” (host below).
# CNBC_MARKETS_NEWS_HOST=cnbc-markets-and-news-data.p.rapidapi.com
# Comma-separated categories: latest, business, finance, economy, politics, technology
# CNBC_MARKETS_NEWS_CATEGORIES=latest,business,finance,economy
# CNBC_MARKETS_NEWS_LIMIT=24
# CNBC_MARKETS_NEWS_REQUEST_GAP_MS=550
# CNBC_MARKETS_NEWS_DISABLED=1

# Reuters Business and Financial News (RapidAPI) — dashboard “Reuters” section.
# GET /get-articles-between-dates/{fromDate}/{toDate}/{page}/{limit} (YYYY-MM-DD, UTC window).
# Same RAPIDAPI_KEY. https://rapidapi.com → “Reuters Business and Financial News” → subscribe.
# REUTERS_BUSINESS_NEWS_HOST=reuters-business-and-financial-news.p.rapidapi.com
# REUTERS_BUSINESS_NEWS_LIMIT=18
# REUTERS_BUSINESS_NEWS_LOOKBACK_DAYS=5
# REUTERS_BUSINESS_NEWS_PAGE=0
# REUTERS_BUSINESS_NEWS_DISABLED=1

# NEWS_RAPIDAPI_KEY=   # alias
# RAPIDAPI_CNBC_URL=https://....p.rapidapi.com/...?...
# RAPIDAPI_REUTERS_URL=
# RAPIDAPI_BLOOMBERG_URL=

# --- Associated Press Media API (contract; not RapidAPI) ---
# https://developer.ap.org — x-api-key header; use your approved feed URL or build from q=
AP_MEDIA_API_KEY=
# Full feed URL (preferred):
# AP_MEDIA_FEED_URL=https://api.ap.org/media/v/content/feed?q=...
# Or query string only:
# AP_MEDIA_FEED_QUERY=productid:YOUR_PRODUCT_ID

# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# https://developer.schwab.com
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=http://localhost:8787/api/auth/schwab/callback

# https://console.anthropic.com — Claude / Anthropic (Messages API)
# Add claude API key here in your real `.env` at repo root (this file is safe to commit; never paste a real key here).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# AI_BRIEFING_CACHE_MS=120000
# CORPUS_MAIN_CAP=40
# CORPUS_MAX_ITEMS=64
# CORPUS_YAHOO_FINANCE_CAP=14

# https://platform.openai.com/api-keys — ChatGPT / OpenAI (Chat Completions API)
# Same pattern as Anthropic: put the secret in root `.env` only (never commit real keys).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BRIEFING_DISABLED=0
# TRADE_SUGGEST_OPENAI_DISABLED=0
# TRADE_SUGGEST_OPENAI_TOKENS=420

# Structured trade AI view (bias + echoed levels + thesis) — GET /api/stocks/trade-ai-view/:symbol & /api/discover/trade-ai-view
# TRADE_AI_VIEW_DISABLED=0
# TRADE_AI_VIEW_TOP_N=5
# TRADE_AI_VIEW_CACHE_MS=25000
# TRADE_AI_VIEW_CLAUDE_TOKENS=900
# TRADE_AI_VIEW_OPENAI_TOKENS=900
# TRADE_AI_VIEW_OPENAI_DISABLED=0

# --- Server-side caching & scheduled refresh ---
# Per-feed RapidAPI response cache TTL (ms). Default: 900000 (15 min).
# RAPIDAPI_CACHE_MS=900000
# Assembled discover payload cache TTL (ms). Default: 300000 (5 min).
# DISCOVER_PAYLOAD_CACHE_MS=300000
# Scheduled refresh intervals (ms). Server fetches data on these cycles even without a browser.
# REFRESH_MARKET_HOURS_MS=1800000    # 30 min during NYSE 9:30 AM – 4:00 PM ET (Mon-Fri)
# REFRESH_OFF_HOURS_MS=7200000       # 2 hr outside market hours (weekday evenings/mornings)
# REFRESH_WEEKEND_MS=14400000        # 4 hr on weekends
# SCHEDULER_INITIAL_DELAY_MS=15000   # Delay before first scheduled refresh after server start
# SERVER_SCHEDULER_DISABLED=0        # Set to 1 to disable server-side scheduled refresh

# Live trade suggestions (Schwab + ATR rules + Claude narration). Does not place orders.
# TRADE_SUGGEST_TOP_N=5
# TRADE_SUGGEST_UNIVERSE_MAX=25
# TRADE_SUGGEST_HISTORY_MAX_SYMBOLS=12
# TRADE_SUGGEST_HISTORY_GAP_MS=220
# TRADE_SUGGEST_CACHE_MS=25000
# TRADE_SUGGEST_SEED_SYMBOLS=AAPL,MSFT
# TRADE_STOP_ATR_MULT=1.45
# TRADE_TARGET1_ATR_MULT=1.05
# TRADE_TARGET2_ATR_MULT=2.1
